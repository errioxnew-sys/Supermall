rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'errioxnew@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Businesses (Public read for mall visitors, store management)
    match /businesses/{businessId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Categories (Public read, admin/seed management)
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Bookings (Customer can create, business owner/customer/admin can read and update)
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Reviews (Public read, customer can create, admin can moderate)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Orders (Customer cart checkout, merchant fulfillment, admin tracking)
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Static Content (About, Shipping & Returns)
    match /content/{contentId} {
      allow read: if true;
      allow write: if true;
    }

    // FAQs
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    // Help Articles
    match /help_articles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    // Issue Reports
    match /issue_reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Mall Settings / Announcements
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Health / Connection test
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
